{
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "bundler", // helps with modern monorepo setups
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "esnext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
