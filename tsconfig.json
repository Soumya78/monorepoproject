{
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "Node", // helps with modern monorepo setups
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions":true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "target": "es2020",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

  }
}
